{
  "name": "room-that-fights-back",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run-rules.ts && tsx eval/golden.ts && tsx eval/tier2.ts && tsx eval/story.ts",
    "eval:rules": "tsx eval/run-rules.ts",
    "eval:golden": "tsx eval/golden.ts",
    "eval:gemma": "tsx eval/run-gemma.ts",
    "eval:archetypes": "tsx eval/archetypes.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
